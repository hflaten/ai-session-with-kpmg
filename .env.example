LLM_PROVIDER=anthropic            # anthropic | openai
ANTHROPIC_API_KEY=paste-here
ANTHROPIC_MODEL=paste-here
OPENAI_API_KEY=paste-here
OPENAI_MODEL=paste-here
OPENAI_BASE_URL=https://api.openai.com/v1   # swap for Azure/KPMG endpoint if needed
OPENAI_REASONING_EFFORT=          # optional: none | low | medium | high. Leave empty to not send it
EMBEDDING_MODEL=text-embedding-3-small
SUPABASE_PROJECT_REF=filled-by-claude
SUPABASE_URL=filled-by-claude
SUPABASE_ANON_KEY=filled-by-claude          # safe for Lovable frontend
SUPABASE_SERVICE_ROLE_KEY=filled-by-claude  # backend only
SUPABASE_DB_PASSWORD=filled-by-claude
SUPABASE_DB_URL=filled-by-claude            # main connection string
SUPABASE_READONLY_DB_URL=filled-by-claude   # used by query_database tool
ALLOWED_ORIGINS=http://localhost:3000,https://*.lovable.app,https://*.lovableproject.com
APP_API_KEY=filled-by-claude                  # shared token, X-API-Key header
